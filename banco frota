let records = [];
let editingId = null;
let supabaseClient = null;
function escapeHtml(value) { return String(value ?? "").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])); }
function fmtDate(value) { if(!value)return ""; const d=new Date(value); return Number.isNaN(d.getTime())?value:d.toLocaleString("pt-BR"); }
function currentLocalDateTime(){const d=new Date();d.setMinutes(d.getMinutes()-d.getTimezoneOffset());return d.toISOString().slice(0,16);}
function showToast(msg){const el=document.getElementById("toast");el.textContent=msg;el.classList.add("show");setTimeout(()=>el.classList.remove("show"),2800);}
function dbRowToRecord(r){return {id:r.id,plate:r.placa,date:r.data_vistoria,inspector:r.responsavel||"",fuel:r.nivel_combustivel||"",general:r.estado_geral||"",oil:r.oleo||"",water:r.agua||"",battery:r.bateria||"",exchange_status:r.situacao_troca|| (r.apto_troca===true?"Sim":r.apto_troca===false?"Não":""),notes:r.observacoes||""};}
function recordToDb(r){return {placa:r.plate,data_vistoria:new Date(r.date).toISOString(),responsavel:r.inspector,nivel_combustivel:r.fuel,estado_geral:r.general,oleo:r.oil,agua:r.water,bateria:r.battery,situacao_troca:r.exchange_status,apto_troca:r.exchange_status==="Sim",observacoes:r.notes};}
function requireClient(){if(!window.supabase||!window.SUPABASE_URL||!window.SUPABASE_ANON_KEY||window.SUPABASE_URL.includes("COLE_AQUI")||window.SUPABASE_ANON_KEY.includes("COLE_AQUI")) throw new Error("Falta configurar a API URL e a Publishable key no arquivo config.js."); if(!supabaseClient)supabaseClient=window.supabase.createClient(window.SUPABASE_URL,window.SUPABASE_ANON_KEY); return supabaseClient;}
async function checkPassword(){try{const sb=requireClient();const email=document.getElementById("loginEmail").value.trim();const password=document.getElementById("loginPassword").value;const {error}=await sb.auth.signInWithPassword({email,password});if(error)throw error;document.getElementById("login").classList.add("hidden");document.getElementById("app").classList.remove("hidden");document.getElementById("passwordError").textContent="";await initializeApp();}catch(e){document.getElementById("passwordError").textContent=e.message||"Não foi possível entrar.";}}
async function initializeApp(){document.getElementById("visitDate").value=currentLocalDateTime();await refreshRecords();}
async function refreshRecords(){const sb=requireClient();const {data,error}=await sb.from("vistorias").select("*").order("data_vistoria",{ascending:false});if(error)throw error;records=(data||[]).map(dbRowToRecord);renderRecords();renderStats();}
function setPage(page){document.querySelectorAll(".page").forEach(p=>p.classList.toggle("active",p.id===`page-${page}`));document.querySelectorAll("[data-page]").forEach(b=>b.classList.toggle("active",b.dataset.page===page));if(page==="lista")renderRecords();if(page==="cadastro")document.getElementById("plate").focus();}
function resetForm(){editingId=null;document.getElementById("inspectionForm").reset();document.getElementById("visitDate").value=currentLocalDateTime();document.getElementById("formTitle").textContent="Nova vistoria";document.getElementById("saveBtn").textContent="Salvar vistoria";document.getElementById("cancelEdit").classList.add("hidden");}
async function submitInspection(event){event.preventDefault();const r={plate:document.getElementById("plate").value.trim().toUpperCase().replace(/\s+/g,""),date:document.getElementById("visitDate").value||currentLocalDateTime(),inspector:document.getElementById("inspector").value.trim(),fuel:document.getElementById("fuel").value,general:document.getElementById("general").value,oil:document.getElementById("oil").value,water:document.getElementById("water").value,battery:document.getElementById("battery").value,exchange_status:document.getElementById("exchange").value,notes:document.getElementById("notes").value.trim()};try{const sb=requireClient();let q=sb.from("vistorias");q=editingId?q.update(recordToDb(r)).eq("id",editingId):q.insert(recordToDb(r));const {error}=await q;if(error)throw error;const wasEditing=editingId!==null;await refreshRecords();resetForm();setPage("lista");showToast(wasEditing?"Vistoria atualizada.":"Vistoria salva na base online.");}catch(e){showToast(e.message||"Não foi possível salvar.");}}
function editRecord(id){const r=records.find(x=>String(x.id)===String(id));if(!r)return;editingId=id;setPage("cadastro");for(const [el,key] of [["plate","plate"],["visitDate","date"],["inspector","inspector"],["fuel","fuel"],["general","general"],["oil","oil"],["water","water"],["battery","battery"],["exchange","exchange_status"],["notes","notes"]]){let v=r[key]||"";if(el==="visitDate"&&v){const d=new Date(v);d.setMinutes(d.getMinutes()-d.getTimezoneOffset());v=d.toISOString().slice(0,16);}document.getElementById(el).value=v;}document.getElementById("formTitle").textContent=`Editar vistoria — ${r.plate}`;document.getElementById("saveBtn").textContent="Salvar alterações";document.getElementById("cancelEdit").classList.remove("hidden");}
async function deleteRecord(id){const r=records.find(x=>String(x.id)===String(id));if(!r||!confirm(`Excluir a vistoria da placa ${r.plate}?`))return;try{const {error}=await requireClient().from("vistorias").delete().eq("id",id);if(error)throw error;await refreshRecords();showToast("Registro excluído.");}catch(e){showToast(e.message||"Não foi possível excluir.");}}
function renderStats(){document.getElementById("statTotal").textContent=records.length;document.getElementById("statRepair").textContent=records.filter(r=>["Mediano","Ruim"].includes(r.general)||r.exchange_status==="Somente após reparos"||["Baixo","Muito baixo"].includes(r.oil)||["Baixo","Muito baixo"].includes(r.water)||r.battery==="Ruim").length;document.getElementById("statExchange").textContent=records.filter(r=>r.exchange_status==="Sim").length;document.getElementById("statNotExchange").textContent=records.filter(r=>r.exchange_status==="Não").length;}
function statusClass(v){return({"Ótimo":"good","Bom":"good","Mediano":"warn","Ruim":"bad","Sim":"good","Não":"bad","Somente após reparos":"warn"})[v]||"neutral";}
function renderRecords(){const q=(document.getElementById("searchBox")?.value||"").trim().toUpperCase(),filter=document.getElementById("filterExchange")?.value||"",list=records.filter(r=>(!q||r.plate.includes(q)||(r.notes||"").toUpperCase().includes(q))&&(!filter||r.exchange_status===filter)),tbody=document.getElementById("recordsBody");if(!list.length){tbody.innerHTML='<tr><td colspan="7" class="empty">Nenhuma vistoria encontrada.</td></tr>';return;}tbody.innerHTML=list.map(r=>`<tr><td><strong>${escapeHtml(r.plate)}</strong><small>${escapeHtml(fmtDate(r.date))}</small></td><td><span class="pill ${statusClass(r.general)}">${escapeHtml(r.general||"—")}</span></td><td>${escapeHtml(r.fuel||"—")}</td><td>${escapeHtml(r.oil||"—")} / ${escapeHtml(r.water||"—")} / ${escapeHtml(r.battery||"—")}</td><td><span class="pill ${statusClass(r.exchange_status)}">${escapeHtml(r.exchange_status||"—")}</span></td><td>${escapeHtml(r.notes||"—")}</td><td class="actions"><button class="small secondary" onclick="editRecord('${r.id}')">Editar</button><button class="small danger" onclick="deleteRecord('${r.id}')">Excluir</button></td></tr>`).join("");}
function csvCell(v){return '"'+String(v??"").replace(/"/g,'""')+'"';}
function exportCSV(){const headers=["ID","Placa","Data e hora","Responsável","Combustível","Estado geral","Óleo","Água","Bateria","Apto para troca","Observações"];const rows=records.map(r=>[r.id,r.plate,r.date,r.inspector,r.fuel,r.general,r.oil,r.water,r.battery,r.exchange_status,r.notes]);const csv='\ufeff'+[headers,...rows].map(row=>row.map(csvCell).join(';')).join('\r\n');downloadBlob(csv,"vistorias_frota.csv","text/csv;charset=utf-8");}
function downloadBlob(content,name,type){const blob=new Blob([content],{type});const url=URL.createObjectURL(blob);const a=document.createElement("a");a.href=url;a.download=name;document.body.appendChild(a);a.click();a.remove();URL.revokeObjectURL(url);}
function exportBackup(){downloadBlob(JSON.stringify({version:1,exportedAt:new Date().toISOString(),records},null,2),"backup_vistoria_frota.json","application/json");}
async function importBackup(event){const file=event.target.files[0];if(!file)return;try{const data=JSON.parse(await file.text());if(!Array.isArray(data.records))throw new Error("Arquivo não reconhecido.");if(!confirm(`Importar ${data.records.length} registros para a base online? Os registros com os mesmos IDs poderão ser atualizados.`))return;const sb=requireClient();const rows=data.records.map(r=>({...recordToDb(r),...(Number.isFinite(Number(r.id))?{id:Number(r.id)}:{})}));const {error}=await sb.from("vistorias").upsert(rows);if(error)throw error;await refreshRecords();showToast("Backup importado.");}catch(e){showToast(e.message||"Não foi possível importar o backup.");}event.target.value="";}
async function changePassword(){try{const password=document.getElementById("newPass").value;if(password.length<8)throw new Error("A nova senha deve ter pelo menos 8 caracteres.");const {error}=await requireClient().auth.updateUser({password});if(error)throw error;document.getElementById("newPass").value="";showToast("Senha alterada.");}catch(e){showToast(e.message||"Não foi possível alterar a senha.");}}
async function logout(){try{await requireClient().auth.signOut();}catch{}document.getElementById("app").classList.add("hidden");document.getElementById("login").classList.remove("hidden");document.getElementById("loginPassword").value="";}
